# Local development. Copy to .env and fill in. In Azure these come from the Container App.
BOB_ENVIRONMENT=dev
BOB_DATABASE_URL=postgresql+psycopg://bob:bob@localhost:5432/bob

BOB_MAILBOX=bob@bridgewerk.ca
# Who gets Bob's questions and digest; only their replies can approve anything.
BOB_REVIEWER_ADDRESSES=["oliver@bridgewerk.ca"]
BOB_DIGEST_HOUR_UTC=13
BOB_INTERNAL_DOMAINS=["bridgewerk.ca"]
BOB_KNOWN_SENDER_ADDRESSES=[]
BOB_GRAPH_TENANT_ID=
BOB_GRAPH_CLIENT_ID=
BOB_GRAPH_CLIENT_SECRET=

BOB_FOUNDRY_RESOURCE=
# Leave empty to sign in with Entra ID (az login locally, managed identity in Azure).
BOB_FOUNDRY_API_KEY=
BOB_MODEL=claude-opus-5-5

# Set to false to run only the API (no mailbox polling).
BOB_RUN_WORKER=true

# QuickBooks Online (Intuit Developer app). Connect once with: python -m bob.qbo.connect
BOB_QBO_ENVIRONMENT=sandbox
BOB_QBO_CLIENT_ID=
BOB_QBO_CLIENT_SECRET=
BOB_QBO_REDIRECT_URI=http://localhost:8765/qbo/callback
BOB_QBO_WRITES_ENABLED=false

# Placeholders until agreed with the accountant.
BOB_MATERIALITY=25000
BOB_DAILY_POST_CAP_COUNT=25
BOB_DAILY_POST_CAP_AMOUNT=50000
# QBO account that pays card receipts (company card or Float clearing). Unset: receipts are held.
BOB_EXPENSE_PAYMENT_ACCOUNT_ID=
